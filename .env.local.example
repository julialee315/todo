# Supabase — Production-safe publishable key only.
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# DO NOT add the `service_role` key here or anywhere with a NEXT_PUBLIC_ prefix.
# It bypasses RLS and would be exposed to all browsers.
